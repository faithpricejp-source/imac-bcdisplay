<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.bcdisplay.receiver</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/Applications/BCDReceiver.app/Contents/MacOS/bcd-receiver</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/bcdisplay/receiver.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/bcdisplay/receiver.log</string>
</dict></plist>
